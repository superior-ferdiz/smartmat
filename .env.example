# Copy to .env and fill in. .env is ignored by Git; this file only shows which variables exist.

# Password for the local Postgres container (docker/compose.yml). Any long random string.
POSTGRES_PASSWORD=change-me

# Postgres listens on 127.0.0.1:55432 (not 5432, to stay clear of other services on the machine).
DATABASE_URL=postgresql://smartmat:change-me@127.0.0.1:55432/smartmat
# Used by the API tests and Playwright. Their names must end in _test / _e2e (checked before tests wipe them).
TEST_DATABASE_URL=postgresql://smartmat:change-me@127.0.0.1:55432/smartmat_test
E2E_DATABASE_URL=postgresql://smartmat:change-me@127.0.0.1:55432/smartmat_e2e

# The API. The Vite dev server forwards /api to it, so the browser only ever talks to one origin.
API_HOST=127.0.0.1
API_PORT=3100
# Origins allowed to send changing requests (POST/PATCH/DELETE). Comma-separated.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Secure cookies. Chromium and Firefox accept them on http://127.0.0.1 and http://localhost; Safari does not.
COOKIE_SECURE=true
LOG_LEVEL=info

# Receipt OCR (phase 8, spec 08, ADR-0017). Off by default: the receipt page then offers the manual form.
# Locally Tesseract runs in Docker without a network (build it once: docker build -t smartmat-ocr docker/ocr),
# and the worker reads the queue: npm run worker -w @smartmat/api
# OCR_PROVIDER=tesseract
# OCR_TESSERACT_COMMAND=docker run --rm -i --network none smartmat-ocr timeout 55 tesseract
# ADR-0017: the parsed lines are not suggested until a new measurement shows the amounts can be trusted.
# RECEIPT_LINE_SUGGESTIONS=false

# Recipes from open sources (spec 09, ADR-0016). false hides external recipes nobody in the team has checked yet;
# meant for a future production environment. Locally and in the test environment they are shown, marked "KI-utkast".
# RECIPES_INCLUDE_UNREVIEWED=true
# The recipe import script (npm run recipes:fetch -w @smartmat/api) names this in its User-Agent to Wikimedia.
# WIKIMEDIA_CONTACT=https://github.com/superior-ferdiz

# Prices from Kassalapp (phase 12, spec 12, ADR-0020, docs/development/integrations/kassalapp.md). Off without a key:
# the app then shows only the household's own prices. The key belongs to one person's Kassalapp account (Hobby,
# non-commercial). Put it here only – never in the repo, the chat, logs or tests.
# KASSALAPP_API_KEY=
# KASSALAPP_BASE_URL=https://kassal.app/api/v1
# Our calls per minute for the whole server (Kassalapp allows 60 per account) and external lookups per user.
# KASSALAPP_MAX_PER_MINUTE=30
# PRICE_LOOKUPS_PER_MINUTE=30

# Spec 13 (FR-AUTH-010): 32 bytes in base64 that encrypt the two-factor secrets (make one: openssl rand -base64 32).
# Empty = two-factor cannot be turned on. Keep a copy with the backup passphrase: without this key, accounts with
# two-factor on cannot log in after a restore. Never in the repo, the chat or a log.
TOTP_ENCRYPTION_KEY=
