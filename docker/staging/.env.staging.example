# The closed test environment (ADR-0015). Copy to docker/staging/.env.staging and fill in. Never commit that file.

# Password for the test environment's own database (not the local one). A long random string.
STAGING_POSTGRES_PASSWORD=change-me

APP_ORIGINS=https://smartmat.risansolutions.no
COOKIE_SECURE=true
COOKIE_HOST_PREFIX=true
# Only Caddy may say who the client is (X-Forwarded-For). smartmat-edge has only Caddy and the app (ADR-0022):
#   docker network inspect smartmat-edge --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUST_PROXY=192.168.252.0/28
REGISTRATION_OPEN=false
LOG_LEVEL=info

# Open Food Facts (docs/development/integrations/open-food-facts.md). Without OFF_USER_AGENT the lookup is off
# and everyone fills in the form by hand. OFF asks for "AppName/Version (contact e-mail)".
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=

# Receipt OCR (phase 8, spec 08, ADR-0017). Read by both the app (to accept uploads) and the worker container (which
# runs Tesseract inside its own image, without internet). Set OCR_PROVIDER=off to switch receipt reading off.
OCR_PROVIDER=tesseract
OCR_TESSERACT_COMMAND=timeout 55 tesseract
# ADR-0017: no line suggestions until a new measurement shows the amounts can be trusted.
RECEIPT_LINE_SUGGESTIONS=false

# Prices from Kassalapp (phase 12, spec 12, ADR-0020, docs/development/integrations/kassalapp.md). Empty = off: the
# app shows only the household's own prices. The key belongs to one team member's Kassalapp account (Hobby,
# non-commercial). Only in docker/staging/.env.staging – never in the repo, the chat, logs or tests.
KASSALAPP_API_KEY=

# Spec 13 (FR-AUTH-008, integrations/pwned-passwords.md): refuse passwords known from breaches at registration and
# password change. Only the first 5 characters of the password's SHA-1 are sent. "off" switches it off.
PWNED_PASSWORDS=on

# Spec 13 (NFR-OPS-003, ADR-0021): written by docker/backup/check-backup.sh on the host, mounted read-only.
BACKUP_STATUS_FILE=/run/smartmat-backup/status.json

# Spec 13 (FR-AUTH-010): 32 bytes in base64 that encrypt the two-factor secrets (make one: openssl rand -base64 32).
# Empty = two-factor cannot be turned on. Keep a copy with the backup passphrase: without this key, accounts with
# two-factor on cannot log in after a restore. Never in the repo, the chat or a log.
TOTP_ENCRYPTION_KEY=

# Spec 17 (FR-AUTH-006, ADR-0024): e-mail for "Glemt passord", sent by the mailer container through SMTP. Off unless
# SMTP_HOST, SMTP_USER, SMTP_PASSWORD and MAIL_FROM are all set: the page then says the feature is not available.
# SMTP_PASSWORD is a Gmail app password (in staging the same one Risan Solutions uses; Google account → Security → App passwords; needs 2-step
# verification). Only in docker/staging/.env.staging – never in the repo, the chat, logs or tests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=SmartMat
