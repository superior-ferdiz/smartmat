// SmartMat database schema. This file is the source of truth for the data model
// (docs/development/data-model.md describes the plan and the reasons).
//
// Conventions:
// - Table and column names in the database are snake_case (@@map / @map); Prisma models use camelCase.
// - IDs are UUIDs, so they cannot be guessed or counted.
// - Every household-owned table gets a household_id (ADR-0008). Child tables repeat it and point to their
//   parent with a composite foreign key (id, household_id), so the database itself refuses to link rows
//   from two different households.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  owner
  member

  @@map("household_role")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and in lower case, so "Ola@Example.no" and "ola@example.no" are the same account.
  email             String    @unique @db.VarChar(254)
  /// argon2id hash (ADR-0005). The password itself is never stored.
  passwordHash      String    @map("password_hash")
  displayName       String    @map("display_name") @db.VarChar(50)
  /// "nb-NO" or "en" (CHECK constraint in the migration).
  locale            String    @default("nb-NO") @db.VarChar(10)
  /// FR-AUTH-003: failed logins in a row, and when the account may try again after too many.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  loginLockedUntil  DateTime? @map("login_locked_until") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Spec 10 (FR-HH-004): the household the user last chose. Checked against the memberships on every read;
  /// if the user is no longer a member, the oldest membership is used instead.
  activeHouseholdId String?   @map("active_household_id") @db.Uuid

  activeHousehold      Household?            @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id], onDelete: SetNull)
  sessions             Session[]
  memberships          HouseholdMember[]
  inventoryEvents      InventoryEvent[]
  purchases            Purchase[]
  allergens            UserAllergen[]
  shoppingItems        ShoppingListItem[]
  mealEntries          MealPlanEntry[]
  receipts             Receipt[]
  invitationsMade      HouseholdInvitation[] @relation("InvitationCreatedBy")
  invitationsUsed      HouseholdInvitation[] @relation("InvitationUsedBy")
  notificationSettings NotificationSettings?

  @@map("users")
}

model Household {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members          HouseholdMember[]
  storageLocations StorageLocation[]
  inventoryItems   InventoryItem[]
  inventoryBatches InventoryBatch[]
  inventoryEvents  InventoryEvent[]
  purchases        Purchase[]
  purchaseLines    PurchaseLine[]
  foodBudgets      FoodBudget[]
  shoppingList     ShoppingList?
  shoppingItems    ShoppingListItem[]
  shoppingShares   ShoppingListItemRecipe[]
  mealEntries      MealPlanEntry[]
  mealShares       ShoppingListItemMeal[]
  barcodes         HouseholdBarcode[]
  receipts         Receipt[]
  receiptImages    ReceiptImage[]
  receiptExtracts  ReceiptExtraction[]
  invitations      HouseholdInvitation[]
  activeFor        User[]                   @relation("ActiveHousehold")

  @@map("households")
}

model HouseholdMember {
  householdId    String        @map("household_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           HouseholdRole
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Spec 10 (FR-HH-006): the member's own allergies count for the whole household. Voluntary (GDPR art. 9),
  /// off by default, per household. Other members see which allergens, never whose.
  shareAllergens Boolean       @default(false) @map("share_allergens")
  /// Spec 11 (FR-NOTIF-003): when the member last saw the shopping list. Lines others added after this give a
  /// notification. Set to now() on joining, so old lines do not.
  shoppingSeenAt DateTime      @default(now()) @map("shopping_seen_at") @db.Timestamptz(3)

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationStates NotificationState[]

  // Exactly one owner per household: partial unique index household_members_one_owner (raw SQL in the migration).
  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

/// Spec 10 (FR-HH-001): a one-time invitation link. Only the SHA-256 of the token is stored; the token itself
/// is shown once to the owner and travels in the link's fragment (#), so it never reaches the server's logs.
model HouseholdInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  usedById    String?   @map("used_by") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy    User?     @relation("InvitationUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  // CHECK (migration): not both used and revoked.
  @@index([householdId, createdAt])
  @@map("household_invitations")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the random session token in the cookie (hex). The token itself is never stored,
  /// so a copy of the database cannot be used to log in.
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  /// Sent back by the browser in the X-CSRF-Token header on changing requests.
  csrfToken  String   @map("csrf_token") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// The earlier of "14 days after last use" and "30 days after login". Moved forward on use.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Phase 3: inventory (spec 03) ──────────────────────────────────────────────────────────────

enum LocationKind {
  fridge
  freezer
  pantry
  other

  @@map("location_kind")
}

enum ExpiryKind {
  best_before
  use_by

  @@map("expiry_kind")
}

enum InventoryEventType {
  add
  consume
  discard
  move
  adjust
  undo

  @@map("inventory_event_type")
}

enum WasteReason {
  expired
  spoiled
  leftovers
  tooMuch   @map("too_much")
  other

  @@map("waste_reason")
}

enum WasteValueBasis {
  actual
  estimated
  unknown

  @@map("waste_value_basis")
}

enum BaseUnit {
  g
  ml
  stk

  @@map("base_unit")
}

/// Global list, seeded by the migration. The app translates the key ("dairy" → "Meieri og egg").
model Category {
  key       String @id @db.VarChar(32)
  sortOrder Int    @map("sort_order")

  items         InventoryItem[]
  purchaseLines PurchaseLine[]
  ingredients   Ingredient[]
  products      Product[]
  barcodes      HouseholdBarcode[]

  @@map("categories")
}

model StorageLocation {
  id          String       @id @default(uuid(7)) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  kind        LocationKind
  /// null for the default locations; the app shows the translated kind instead.
  name        String?      @db.VarChar(50)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  batches   InventoryBatch[]
  movedFrom InventoryEvent[]   @relation("EventFromLocation")
  movedTo   InventoryEvent[]   @relation("EventToLocation")
  barcodes  HouseholdBarcode[]

  @@unique([id, householdId])
  @@index([householdId])
  @@map("storage_locations")
}

/// What the household has ("Lettmelk"). Free-text name until the product catalogue arrives (phase 7).
model InventoryItem {
  id              String          @id @default(uuid(7)) @db.Uuid
  householdId     String          @map("household_id") @db.Uuid
  name            String          @db.VarChar(100)
  categoryKey     String          @map("category_key") @db.VarChar(32)
  unit            BaseUnit
  /// Phase 5 (spec 05): how the item is linked to a recipe ingredient. auto = by name (aliases), manual = the
  /// user chose ingredient_id, none = the user said it is no ingredient. CHECK: ingredient_id only with manual.
  ingredientMatch IngredientMatch @default(auto) @map("ingredient_match")
  ingredientId    String?         @map("ingredient_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  household  Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category   Category           @relation(fields: [categoryKey], references: [key])
  /// RESTRICT: the seed script only removes ingredients that nothing uses.
  ingredient Ingredient?        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  batches    InventoryBatch[]
  events     InventoryEvent[]
  barcodes   HouseholdBarcode[]

  @@unique([id, householdId])
  @@index([householdId])
  @@map("inventory_items")
}

/// One physical pack or purchase of an item, with its own quantity, place and date.
model InventoryBatch {
  id                  String      @id @default(uuid(7)) @db.Uuid
  householdId         String      @map("household_id") @db.Uuid
  itemId              String      @map("item_id") @db.Uuid
  locationId          String      @map("location_id") @db.Uuid
  /// Whole grams / millilitres / pieces (ADR-0006). 0 = used up (hidden, kept for history).
  quantityBase        Int         @map("quantity_base")
  initialQuantityBase Int         @map("initial_quantity_base")
  expiryKind          ExpiryKind? @map("expiry_kind")
  expiryDate          DateTime?   @map("expiry_date") @db.Date
  /// Price for the whole batch in øre, used to estimate the value of food thrown away.
  priceOre            Int?        @map("price_ore")
  purchasedOn         DateTime?   @map("purchased_on") @db.Date
  /// The purchase line the batch came from (phase 4, FR-BUD-002); null when added in the inventory or unlinked.
  purchaseLineId      String?     @map("purchase_line_id") @db.Uuid
  /// Phase 7 (spec 07, FR-SCAN-005): "scan:<clientRequestId>", so a confirmation sent twice gives one batch.
  dedupeKey           String?     @map("dedupe_key") @db.VarChar(80)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item         InventoryItem    @relation(fields: [itemId, householdId], references: [id, householdId], onDelete: Cascade)
  /// NO ACTION (checked at the end of the statement): deleting a household cascades to both batches and
  /// locations, and a RESTRICT here could fire before the batches are gone. Deleting a location that still
  /// has batches is still refused.
  location     StorageLocation  @relation(fields: [locationId, householdId], references: [id, householdId], onDelete: NoAction)
  /// NO ACTION for the same reason; the app clears the link before it deletes a line (spec 04, FR-BUD-005).
  /// SET NULL is not an option: on a composite key it would also clear household_id.
  purchaseLine PurchaseLine?    @relation(fields: [purchaseLineId, householdId], references: [id, householdId], onDelete: NoAction)
  events       InventoryEvent[]

  @@unique([purchaseLineId, householdId])
  @@unique([householdId, dedupeKey])
  @@index([householdId])
  @@index([itemId])
  @@index([locationId])
  @@map("inventory_batches")
}

/// Append-only history of every change to the inventory, and the food-waste log (type = discard).
model InventoryEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  /// Strict order of events ("the last event" for undo), also when two happen in the same millisecond.
  seq             BigInt             @unique @default(autoincrement())
  householdId     String             @map("household_id") @db.Uuid
  itemId          String             @map("item_id") @db.Uuid
  /// null if the batch was deleted later (e.g. its location was removed while empty).
  batchId         String?            @map("batch_id") @db.Uuid
  type            InventoryEventType
  /// Change in base units: +added, −used/discarded, ±adjusted, 0 for a move.
  deltaBase       Int                @map("delta_base")
  fromLocationId  String?            @map("from_location_id") @db.Uuid
  toLocationId    String?            @map("to_location_id") @db.Uuid
  actorId         String?            @map("actor_id") @db.Uuid
  /// For type = undo: the event it reverted. Unique, so an event can only be undone once.
  revertsEventId  String?            @unique @map("reverts_event_id") @db.Uuid
  wasteReason     WasteReason?       @map("waste_reason")
  wasteValueOre   Int?               @map("waste_value_ore")
  wasteValueBasis WasteValueBasis?   @map("waste_value_basis")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item         InventoryItem    @relation(fields: [itemId, householdId], references: [id, householdId], onDelete: Cascade)
  batch        InventoryBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  fromLocation StorageLocation? @relation("EventFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   StorageLocation? @relation("EventToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  actor        User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  revertsEvent InventoryEvent?  @relation("Undo", fields: [revertsEventId], references: [id], onDelete: Cascade)
  revertedBy   InventoryEvent?  @relation("Undo")

  @@index([householdId, createdAt])
  @@index([itemId, createdAt])
  @@map("inventory_events")
}

// ─── Phase 4: purchases and budget (spec 04) ───────────────────────────────────────────────────

enum PurchaseSource {
  manual
  receipt
  barcode

  @@map("purchase_source")
}

enum PurchaseLineKind {
  food
  nonFood @map("non_food")

  @@map("purchase_line_kind")
}

/// One shopping trip. The single source of spending (ADR-0007): budget figures are always computed from these.
model Purchase {
  id          String         @id @default(uuid(7)) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  storeName   String?        @map("store_name") @db.VarChar(100)
  purchasedOn DateTime       @map("purchased_on") @db.Date
  /// Sum of the lines, or the amount typed in for a purchase without lines. Whole øre (ADR-0006).
  totalOre    Int            @map("total_ore")
  currency    String         @default("NOK") @db.Char(3)
  source      PurchaseSource @default(manual)
  /// Unique per household: a form sent twice (or a receipt imported twice, phase 8) gives one purchase.
  dedupeKey   String?        @map("dedupe_key") @db.VarChar(100)
  createdById String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines     PurchaseLine[]
  receipt   Receipt?

  @@unique([id, householdId])
  @@unique([householdId, dedupeKey])
  @@index([householdId, purchasedOn])
  @@map("purchases")
}

model PurchaseLine {
  id          String           @id @default(uuid(7)) @db.Uuid
  householdId String           @map("household_id") @db.Uuid
  purchaseId  String           @map("purchase_id") @db.Uuid
  /// Order in the form (0, 1, 2 …).
  position    Int
  description String           @db.VarChar(100)
  kind        PurchaseLineKind
  /// Required for food, empty for non-food (CHECK).
  categoryKey String?          @map("category_key") @db.VarChar(32)
  amountOre   Int              @map("amount_ore")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  purchase  Purchase        @relation(fields: [purchaseId, householdId], references: [id, householdId], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryKey], references: [key], onDelete: Restrict)
  batch     InventoryBatch?

  @@unique([id, householdId])
  @@index([householdId])
  @@index([purchaseId])
  @@map("purchase_lines")
}

/// The monthly food budget, valid from a month onwards. A month uses the row with the latest valid_from
/// that is not after it, so changing the budget does not rewrite earlier months (spec 04, decision 4).
model FoodBudget {
  householdId String   @map("household_id") @db.Uuid
  /// Always the first day of a month (CHECK).
  validFrom   DateTime @map("valid_from") @db.Date
  /// null = no budget from this month on.
  amountOre   Int?     @map("amount_ore")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([householdId, validFrom])
  @@map("food_budgets")
}

// ---------------------------------------------------------------------------------------------------------
// Phase 5: recipes (spec 05). Recipes and ingredients are GLOBAL (no household_id): the same for everyone,
// seeded from prisma/seed/ by `npm run db:seed`, never written through the API. Allergies belong to the user.

enum IngredientMatch {
  auto
  manual
  none

  @@map("ingredient_match")
}

/// The 14 allergens that must be declared under the Norwegian food information regulation (matinformasjonsforskriften).
enum Allergen {
  gluten
  crustaceans
  egg
  fish
  peanuts
  soy
  milk
  nuts
  celery
  mustard
  sesame
  sulphites
  lupin
  molluscs

  @@map("allergen")
}

/// team = written by the students (ADR-0009); test = fictional recipes that only exist in the test databases.
enum RecipeSource {
  team
  /// From an openly licensed source, translated (ADR-0016, spec 09)
  external
  test

  @@map("recipe_source")
}

/// How much an external recipe differs from its original (ADR-0016).
enum RecipeAdaptation {
  none
  translated
  adapted

  @@map("recipe_adaptation")
}

/// A normalised food that recipes use ("melk"). Quantities of it are whole units of base_unit (ADR-0006).
model Ingredient {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable id in the seed files ("melk").
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(60)
  baseUnit    BaseUnit @map("base_unit")
  /// Salt, pepper, oil, water: assumed to be in the kitchen, not counted as missing.
  isStaple    Boolean  @default(false) @map("is_staple")
  categoryKey String?  @map("category_key") @db.VarChar(32)

  category      Category?            @relation(fields: [categoryKey], references: [key], onDelete: SetNull)
  aliases       IngredientAlias[]
  allergens     IngredientAllergen[]
  conversions   UnitConversion[]
  recipes       RecipeIngredient[]
  items         InventoryItem[]
  barcodes      HouseholdBarcode[]
  shoppingItems ShoppingListItem[]

  @@map("ingredients")
}

/// Another name for an ingredient, normalised (lower case, single spaces). Unique across all ingredients,
/// so an item name can never quietly match two of them.
model IngredientAlias {
  alias        String     @id @db.VarChar(60)
  ingredientId String     @map("ingredient_id") @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@map("ingredient_aliases")
}

model IngredientAllergen {
  ingredientId String     @map("ingredient_id") @db.Uuid
  allergen     Allergen
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergen])
  @@map("ingredient_allergens")
}

/// unit_qty of `unit` ≈ base_qty of the ingredient's base unit ("1 stk egg ≈ 60 g"). Whole numbers (ADR-0006).
model UnitConversion {
  ingredientId String     @map("ingredient_id") @db.Uuid
  unit         BaseUnit
  unitQty      Int        @map("unit_qty")
  baseQty      Int        @map("base_qty")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([ingredientId, unit])
  @@map("unit_conversions")
}

model Recipe {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Stable id in the seed files; the seed script upserts on it, so the id survives a re-seed.
  slug           String            @unique @db.VarChar(80)
  title          String            @db.VarChar(120)
  description    String            @db.VarChar(500)
  servings       Int
  prepMinutes    Int               @map("prep_minutes")
  cookMinutes    Int               @map("cook_minutes")
  steps          String[]
  tags           String[]
  source         RecipeSource
  license        String            @db.VarChar(50)
  /// Who really wrote the recipe (ADR-0009); for an external recipe, the original's authors. Never empty (CHECK).
  authors        String[]
  /// ADR-0016 (spec 09): the original of an external recipe, when it was fetched and what was done to it.
  sourceTitle    String?           @map("source_title") @db.VarChar(200)
  sourceUrl      String?           @map("source_url") @db.VarChar(500)
  retrievedOn    DateTime?         @map("retrieved_on") @db.Date
  adaptation     RecipeAdaptation?
  adaptationNote String?           @map("adaptation_note") @db.VarChar(1000)
  aiAssisted     Boolean           @default(false) @map("ai_assisted")
  /// Team members who checked the recipe. Empty = an AI draft ("KI-utkast – ikke kontrollert av teamet").
  reviewedBy     String[]          @default([]) @map("reviewed_by")
  reviewedOn     DateTime?         @map("reviewed_on") @db.Date
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  ingredients    RecipeIngredient[]
  shoppingShares ShoppingListItemRecipe[]
  mealEntries    MealPlanEntry[]

  @@map("recipes")
}

model RecipeIngredient {
  recipeId     String     @map("recipe_id") @db.Uuid
  position     Int
  ingredientId String     @map("ingredient_id") @db.Uuid
  /// In the ingredient's base unit; null = no amount ("etter smak").
  quantityBase Int?       @map("quantity_base")
  /// What the recipe says ("2 dl melk").
  displayText  String     @map("display_text") @db.VarChar(120)
  optional     Boolean    @default(false)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, position])
  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// FR-REC-004. May be health data (GDPR art. 9): voluntary, deleted with the account, never logged.
model UserAllergen {
  userId   String   @map("user_id") @db.Uuid
  allergen Allergen
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, allergen])
  @@map("user_allergens")
}

// ---------------------------------------------------------------------------------------------------------
// Phase 6: shopping list (spec 06). Household data (ADR-0008): every row has household_id, and children point
// to their parent with composite foreign keys.

/// The household's one shopping list (decision 1 in spec 06). Created with the household.
model ShoppingList {
  id          String   @id @default(uuid(7)) @db.Uuid
  householdId String   @unique @map("household_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@unique([id, householdId])
  @@map("shopping_lists")
}

/// One thing to buy. Quantity and unit are both set or both empty (CHECK). A partial unique index (raw SQL in
/// the migration) allows only one open line per ingredient, so merging can never give two lines.
model ShoppingListItem {
  id           String    @id @default(uuid(7)) @db.Uuid
  householdId  String    @map("household_id") @db.Uuid
  listId       String    @map("list_id") @db.Uuid
  text         String    @db.VarChar(100)
  /// From a recipe, or when the text matched one ingredient. Never changed afterwards.
  ingredientId String?   @map("ingredient_id") @db.Uuid
  /// Whole grams / millilitres / pieces (ADR-0006).
  quantityBase Int?      @map("quantity_base")
  unit         BaseUnit?
  checked      Boolean   @default(false)
  checkedAt    DateTime? @map("checked_at") @db.Timestamptz(3)
  /// Unique per household: a form sent twice gives one line (NFR-DATA-002).
  dedupeKey    String?   @map("dedupe_key") @db.VarChar(100)
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  household  Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  list       ShoppingList             @relation(fields: [listId, householdId], references: [id, householdId], onDelete: Cascade)
  /// RESTRICT: the seed script only removes ingredients that nothing uses (spec 06, "Frødata").
  ingredient Ingredient?              @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdBy  User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipes    ShoppingListItemRecipe[]
  meals      ShoppingListItemMeal[]

  @@unique([id, householdId])
  @@unique([householdId, dedupeKey])
  @@index([listId])
  @@index([ingredientId])
  @@map("shopping_list_items")
}

/// Which recipe added how much to a line. The key stops the same recipe from adding to a line twice.
model ShoppingListItemRecipe {
  itemId       String @map("item_id") @db.Uuid
  householdId  String @map("household_id") @db.Uuid
  recipeId     String @map("recipe_id") @db.Uuid
  /// In the ingredient's base unit; null = no amount.
  quantityBase Int?   @map("quantity_base")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      ShoppingListItem @relation(fields: [itemId, householdId], references: [id, householdId], onDelete: Cascade)
  /// CASCADE: a recipe removed by the seed script takes its shares with it; the lines stay.
  recipe    Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([itemId, recipeId])
  @@index([recipeId])
  @@map("shopping_list_item_recipes")
}

// ---------------------------------------------------------------------------------------------------------------
// Phase 9: meal plan (spec 09)
// ---------------------------------------------------------------------------------------------------------------

enum Meal {
  breakfast
  lunch
  dinner

  @@map("meal")
}

/// One thing on one day and one meal: a recipe with servings, or a note ("Rester"). Exactly one of the two
/// (CHECK). `recipe_title` is a copy, so the entry still says what it was if the seed removes the recipe.
model MealPlanEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  date        DateTime @db.Date
  meal        Meal
  /// SET NULL: a recipe removed by the seed script leaves the entry with its title (spec 09).
  recipeId    String?  @map("recipe_id") @db.Uuid
  recipeTitle String?  @map("recipe_title") @db.VarChar(120)
  servings    Int?
  note        String?  @db.VarChar(100)
  /// Unique per household: a form sent twice gives one entry (NFR-DATA-002).
  dedupeKey   String?  @map("dedupe_key") @db.VarChar(100)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    Recipe?                @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  createdBy User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  shares    ShoppingListItemMeal[]

  @@unique([id, householdId])
  @@unique([householdId, dedupeKey])
  @@index([householdId, date])
  @@index([recipeId])
  @@map("meal_plan_entries")
}

/// FR-PLAN-004: how much a planned meal put on a shopping line. What an entry already added is subtracted the
/// next time, so the same need added twice never doubles. Deleting the line or the entry removes the share.
model ShoppingListItemMeal {
  itemId       String @map("item_id") @db.Uuid
  entryId      String @map("entry_id") @db.Uuid
  householdId  String @map("household_id") @db.Uuid
  /// In the ingredient's base unit; null = added without an amount.
  quantityBase Int?   @map("quantity_base")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  item      ShoppingListItem @relation(fields: [itemId, householdId], references: [id, householdId], onDelete: Cascade)
  entry     MealPlanEntry    @relation(fields: [entryId, householdId], references: [id, householdId], onDelete: Cascade)

  @@id([itemId, entryId])
  @@index([entryId])
  @@map("shopping_list_item_meals")
}

// ---------------------------------------------------------------------------------------------------------------
// Phase 7: barcodes (spec 07, ADR-0014)
// ---------------------------------------------------------------------------------------------------------------

/// Global cache of what Open Food Facts answered for a GTIN (ODbL, see docs/development/integrations).
/// No household or user data. Used for 30 days, then asked again.
model Product {
  gtin                String    @id @db.VarChar(14)
  name                String?   @db.VarChar(100)
  brand               String?   @db.VarChar(100)
  /// Pack size in whole grams or millilitres, when OFF gave one we could read.
  packageQuantityBase Int?      @map("package_quantity_base")
  packageUnit         BaseUnit? @map("package_unit")
  categoryKey         String?   @map("category_key") @db.VarChar(32)
  fetchedAt           DateTime  @map("fetched_at") @db.Timestamptz(3)

  category Category? @relation(fields: [categoryKey], references: [key], onDelete: SetNull)

  @@map("products")
}

/// GTINs Open Food Facts did not know, so they are not asked again for 24 hours. Errors are never stored here.
model ProductLookupMiss {
  gtin      String   @id @db.VarChar(14)
  checkedAt DateTime @map("checked_at") @db.Timestamptz(3)

  @@map("product_lookup_misses")
}

/// What the household confirmed last for a GTIN. Wins over Open Food Facts; the only memory of unknown codes.
model HouseholdBarcode {
  householdId     String          @map("household_id") @db.Uuid
  gtin            String          @db.VarChar(14)
  name            String          @db.VarChar(100)
  categoryKey     String          @map("category_key") @db.VarChar(32)
  unit            BaseUnit
  /// The amount confirmed last time, offered again.
  quantityBase    Int?            @map("quantity_base")
  ingredientMatch IngredientMatch @default(auto) @map("ingredient_match")
  ingredientId    String?         @map("ingredient_id") @db.Uuid
  locationId      String?         @map("location_id") @db.Uuid
  expiryKind      ExpiryKind?     @map("expiry_kind")
  /// The item it was added to last time.
  itemId          String?         @map("item_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  household  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryKey], references: [key])
  /// RESTRICT, like inventory_items: the seed script only removes ingredients that nothing uses.
  ingredient Ingredient?      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  /// NO ACTION: the app clears the link before it deletes the item or the location (SET NULL on a composite
  /// key would also clear household_id).
  item       InventoryItem?   @relation(fields: [itemId, householdId], references: [id, householdId], onDelete: NoAction)
  location   StorageLocation? @relation(fields: [locationId, householdId], references: [id, householdId], onDelete: NoAction)

  @@id([householdId, gtin])
  @@index([itemId])
  @@index([locationId])
  @@map("household_barcodes")
}

// ---------- Phase 8: receipt OCR (spec 08, ADR-0011, ADR-0017) ----------

enum ReceiptStatus {
  queued
  processing
  review
  failed
  confirmed

  @@map("receipt_status")
}

/// One uploaded receipt. Kept after confirmation only as the link to its purchase; the image and the extraction
/// are deleted then. Unconfirmed receipts are deleted entirely after `delete_after` (spec 08 FR-RCPT-008).
model Receipt {
  id           String        @id @default(uuid(7)) @db.Uuid
  householdId  String        @map("household_id") @db.Uuid
  status       ReceiptStatus @default(queued)
  /// Why OCR failed: timeout, unavailable, invalidResponse or noText (CHECK).
  failureCode  String?       @map("failure_code") @db.VarChar(30)
  /// Of the stored (rewritten) image: the same file uploaded twice is refused. Cleared on confirmation.
  imageSha256  String?       @map("image_sha256") @db.Char(64)
  uploadedById String?       @map("uploaded_by") @db.Uuid
  purchaseId   String?       @map("purchase_id") @db.Uuid
  deleteAfter  DateTime      @map("delete_after") @db.Timestamptz(3)
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  household  Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Deleting the purchase deletes this row, so the receipt can be imported again.
  purchase   Purchase?          @relation(fields: [purchaseId, householdId], references: [id, householdId], onDelete: Cascade)
  image      ReceiptImage?
  extraction ReceiptExtraction?

  @@unique([id, householdId])
  @@unique([purchaseId])
  @@unique([purchaseId, householdId])
  @@index([householdId, status])
  @@index([deleteAfter])
  @@map("receipts")
}

/// The rewritten JPEG (no metadata). In its own table so it can be deleted on its own and is never read by
/// accident with the receipt.
model ReceiptImage {
  receiptId   String   @id @map("receipt_id") @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  bytes       Bytes
  width       Int
  height      Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  receipt   Receipt   @relation(fields: [receiptId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([receiptId, householdId])
  @@map("receipt_images")
}

/// What OCR and the parser found. The raw text is stored without the payment lines.
model ReceiptExtraction {
  receiptId      String   @id @map("receipt_id") @db.Uuid
  householdId    String   @map("household_id") @db.Uuid
  engine         String   @db.VarChar(60)
  rawText        String   @map("raw_text")
  /// ParsedReceipt from packages/shared/src/receipts/parse.ts
  parsed         Json
  meanConfidence Int      @map("mean_confidence")
  durationMs     Int      @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  receipt   Receipt   @relation(fields: [receiptId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([receiptId, householdId])
  @@map("receipt_extractions")
}

// ─── Phase 11: notifications in the app (spec 11, ADR-0019) ───────────────────────────────────────

/// FR-NOTIF-005: which notifications the user wants, for all their households. No row = the defaults.
model NotificationSettings {
  userId     String   @id @map("user_id") @db.Uuid
  useBy      Boolean  @default(true) @map("use_by")
  bestBefore Boolean  @default(true) @map("best_before")
  /// 0–7 (CHECK in the migration): how many days before the date the "soon" notification starts.
  daysBefore Int      @default(1) @map("days_before") @db.SmallInt
  budget     Boolean  @default(true)
  shopping   Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// FR-NOTIF-004 (ADR-0019): notifications are computed on every read; only what the user did with one is
/// stored, under its fixed key. No content. Belongs to the membership, so leaving the household deletes it.
model NotificationState {
  userId      String    @map("user_id") @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  key         String    @db.VarChar(120)
  seenAt      DateTime  @default(now()) @map("seen_at") @db.Timestamptz(3)
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(3)

  member HouseholdMember @relation(fields: [householdId, userId], references: [householdId, userId], onDelete: Cascade)

  @@id([userId, householdId, key])
  @@index([householdId, userId])
  @@map("notification_states")
}

// ---------- Phase 12: prices (spec 12, ADR-0010, ADR-0020) ----------

enum PriceSource {
  kassalapp

  @@map("price_source")
}

/// The latest price per chain for a GTIN, from an external source (Kassalapp). Global: no household data.
/// An estimate, never spending (ADR-0007). Rows not fetched for 30 days are deleted by the worker.
model PriceObservation {
  id                  String      @id @default(uuid(7)) @db.Uuid
  source              PriceSource
  gtin                String      @db.VarChar(14)
  chainCode           String      @map("chain_code") @db.VarChar(40)
  chainName           String      @map("chain_name") @db.VarChar(60)
  /// The price of the package in øre (ADR-0006).
  priceOre            Int         @map("price_ore")
  /// Pack size in whole grams / millilitres / pieces, when the source gave one we could read.
  packageQuantityBase Int?        @map("package_quantity_base")
  packageUnit         BaseUnit?   @map("package_unit")
  /// When the source last checked the price (Kassalapp's current_price.date), not when we fetched it.
  observedAt          DateTime    @map("observed_at") @db.Timestamptz(3)
  fetchedAt           DateTime    @map("fetched_at") @db.Timestamptz(3)
  /// The product page at the source (https://kassal.app/… only).
  sourceUrl           String?     @map("source_url") @db.VarChar(300)

  @@unique([source, gtin, chainCode])
  @@index([gtin])
  @@index([fetchedAt])
  @@map("price_observations")
}

/// When a GTIN was last asked for at a source, and whether it was found: the 6-hour cache. Errors are never stored.
model PriceLookup {
  source    PriceSource
  gtin      String      @db.VarChar(14)
  fetchedAt DateTime    @map("fetched_at") @db.Timestamptz(3)
  found     Boolean

  @@id([source, gtin])
  @@index([fetchedAt])
  @@map("price_lookups")
}
